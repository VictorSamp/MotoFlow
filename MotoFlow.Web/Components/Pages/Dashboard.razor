@page "/dashboard"

@using MotoFlow.Web.Components.ViewModels.Dashboard
@using MotoFlow.Web.Services
@inject DashboardApiService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid mt-4">

    <h2 class="mb-1">Dashboard</h2>

    <p class="text-muted mb-4">
        Bem-vindo ao MotoFlow. Abaixo estão os principais indicadores do motoclube.
    </p>

    @if (dashboard is null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Carregando informações...</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-muted">Total de Membros</h6>
                        <h2>@dashboard.TotalMembers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-muted">Membros Ativos</h6>
                        <h2 class="text-success">
                            @dashboard.ActiveMembers
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-muted">Membros Inativos</h6>
                        <h2 class="text-danger">
                            @dashboard.InactiveMembers
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="text-muted">Níveis de Insígnia</h6>
                        <h2>@dashboard.PatchLevelsUsed</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="row">

            <div class="col-lg-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-dark text-white">
                        Distribuição por Insígnia
                    </div>

                    <div class="card-body">

                        @if (dashboard.PatchDistribution.Count == 0)
                        {
                            <p class="text-muted mb-0">
                                Nenhuma informação disponível.
                            </p>
                        }
                        else
                        {
                            <table class="table table-striped mb-0">

                                <thead>
                                    <tr>
                                        <th>Insígnia</th>
                                        <th class="text-end">Quantidade</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in dashboard.PatchDistribution)
                                    {
                                        <tr>
                                            <td>
                                                @TranslatePatch(item.Key)
                                            </td>

                                            <td class="text-end">
                                                @item.Value
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>
                        }

                    </div>

                </div>

            </div>

            <div class="col-lg-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-dark text-white">
                        Membros Cadastrados
                    </div>

                    <div class="card-body">

                        @if (dashboard.RecentMembers.Count == 0)
                        {
                            <p class="text-muted mb-0">
                                Nenhum membro cadastrado.
                            </p>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">

                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Insígnia</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var member in dashboard.RecentMembers)
                                    {
                                        <tr>

                                            <td>
                                                @member.Name
                                            </td>

                                            <td>
                                                @TranslatePatch(member.CurrentPatchLevel)
                                            </td>

                                            <td>

                                                @if (member.Status == "Active")
                                                {
                                                    <span class="badge bg-success">
                                                        Ativo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Inativo
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@code {

    private DashboardDto? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardService.GetDashboard();
    }

    private static string TranslatePatch(string level)
    {
        return level switch
        {
            "None" => "Nenhuma Parte",
            "FirstPatch" => "Primeira Etapa",
            "SecondPatch" => "Segunda Etapa",
            "FullPatch" => "Insígnia Completa",
            _ => level
        };
    }
}