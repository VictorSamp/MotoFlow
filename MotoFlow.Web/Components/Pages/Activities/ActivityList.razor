@page "/activities"

@using Microsoft.JSInterop
@using MotoFlow.Application.Activities.CreateActivity
@using MotoFlow.Application.Activities.Dtos
@using MotoFlow.Application.Members.Dtos

@inject IJSRuntime JS
@inject ActivityApiService ActivityService
@inject MemberApiService MemberService

@rendermode InteractiveServer

<PageTitle>Agenda | MotoFlow</PageTitle>

<div class="activity-page">

    <!-- =====================================================
         CABEÇALHO
         ===================================================== -->

    <div class="activity-header">

        <div>

            <div class="breadcrumb-area">
                <span>Principal</span>

                <i class="bi bi-chevron-right"></i>

                <span class="current">
                    Atividades
                </span>
            </div>

            <h1 class="activity-title">
                Agenda de Atividades
            </h1>

            <p class="activity-subtitle">
                Organize as atividades e responsabilidades do motoclube.
            </p>

        </div>

        <button type="button"
                class="btn btn-success activity-create-button"
                @onclick="OpenCreateModal">

            <i class="bi bi-plus-lg"></i>

            <span>
                Nova atividade
            </span>

        </button>

    </div>


    <!-- =====================================================
         CONTEÚDO
         ===================================================== -->
    @if (isLoading)
    {
        <div class="activity-loading">

            <div class="spinner-border"
                 role="status">

                <span class="visually-hidden">
                    Carregando...
                </span>

            </div>

            <strong>
                Carregando agenda...
            </strong>

            <span>
                Aguarde enquanto buscamos as atividades.
            </span>

        </div>
    }
    else if (loadError is not null)
    {
        <div class="activity-error">

            <div class="activity-error-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>

                <strong>
                    Não foi possível carregar a agenda.
                </strong>

                <p>
                    @loadError
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="calendar-card">

            <!-- =================================================
                 CABEÇALHO DO CARD
                 ================================================= -->

            <div class="calendar-card-header">

                <div class="calendar-title-area">

                    <div class="calendar-icon">
                        <i class="bi bi-calendar3"></i>
                    </div>

                    <div>

                        <h5>
                            Agenda do motoclube
                        </h5>

                        <span>
                            Visualize e gerencie as atividades programadas.
                        </span>

                    </div>

                </div>

                <div class="calendar-legend">

                    <div class="legend-item">

                        <span class="legend-dot"></span>

                        <span>
                            Atividade
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 CALENDÁRIO
                 ================================================= -->

            <div class="calendar-body">

                <div id="activity-calendar"
                     class="activity-calendar">
                </div>

            </div>

        </div>
    }

</div>


<!-- =========================================================
     MODAL - CRIAR ATIVIDADE
     ========================================================= -->
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block activity-modal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <div class="modal-heading">

                        <div class="modal-icon create-icon">
                            <i class="bi bi-calendar-plus"></i>
                        </div>

                        <div>

                            <h5>
                                Nova atividade
                            </h5>

                            <span>
                                Cadastre uma nova atividade do motoclube.
                            </span>

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseCreateModal"
                            disabled="@isSaving">
                    </button>

                </div>


                <div class="modal-body">

                    @if (createError is not null)
                    {
                        <div class="form-error">

                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                @createError
                            </span>

                        </div>
                    }


                    <!-- TÍTULO -->

                    <div class="form-group">

                        <label class="form-label">
                            Título
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-card-text"></i>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Digite o título da atividade"
                                   @bind="activityTitle" />

                        </div>

                    </div>


                    <!-- DESCRIÇÃO -->

                    <div class="form-group">

                        <label class="form-label">
                            Descrição
                        </label>

                        <div class="input-wrapper">

                            <textarea class="form-control"
                                      rows="3"
                                      placeholder="Descreva a atividade"
                                      @bind="activityDescription">
                            </textarea>

                            <i class="bi bi-text-left"></i>

                        </div>

                    </div>


                    <!-- DATAS -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                <label class="form-label">
                                    Início
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-calendar-event"></i>

                                    <input type="datetime-local"
                                           class="form-control"
                                           @bind="activityStart" />

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="form-group">

                                <label class="form-label">
                                    Fim
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-calendar-check"></i>

                                    <input type="datetime-local"
                                           class="form-control"
                                           @bind="activityEnd" />

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- RESPONSÁVEIS -->

                    <div class="form-group">

                        <label class="form-label">
                            Responsáveis
                        </label>

                        @if (members is null)
                        {
                            <div class="members-loading">

                                <div class="spinner-border spinner-border-sm"></div>

                                <span>
                                    Carregando membros...
                                </span>

                            </div>
                        }
                        else if (!members.Any())
                        {
                            <div class="empty-members">

                                <i class="bi bi-people"></i>

                                <span>
                                    Nenhum membro encontrado.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="responsible-members">

                                @foreach (var member in members)
                                {
                                    <label class="member-checkbox">

                                        <input type="checkbox"
                                               checked="@selectedMemberIds.Contains(member.Id)"
                                               @onchange="e => ToggleMember(member.Id, e)" />

                                        <span class="member-checkmark">
                                            <i class="bi bi-check"></i>
                                        </span>

                                        <span class="member-name">
                                            @member.Name
                                        </span>

                                    </label>
                                }

                            </div>
                        }

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary modal-cancel-button"
                            @onclick="CloseCreateModal"
                            disabled="@isSaving">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-success modal-save-button"
                            @onclick="CreateActivity"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>

                            <span>
                                Criando...
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>

                            <span>
                                Criar atividade
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}


<!-- =========================================================
     MODAL - DETALHES
     ========================================================= -->
@if (showDetailsModal && selectedActivity is not null)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block activity-modal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <div class="modal-heading">

                        <div class="modal-icon details-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div>

                            <h5>
                                Detalhes da atividade
                            </h5>

                            <span>
                                Informações da atividade selecionada.
                            </span>

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDetailsModal"
                            disabled="@isDeleting">
                    </button>

                </div>


                <div class="modal-body">

                    @if (deleteError is not null)
                    {
                        <div class="form-error">

                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                @deleteError
                            </span>

                        </div>
                    }


                    <div class="activity-detail-title">

                        <h4>
                            @selectedActivity.Title
                        </h4>

                    </div>


                    <!-- DESCRIÇÃO -->

                    <div class="detail-section">

                        <div class="detail-label">

                            <i class="bi bi-card-text"></i>

                            <span>
                                Descrição
                            </span>

                        </div>

                        <div class="detail-content">

                            @(string.IsNullOrWhiteSpace(
                                selectedActivity.Description)
                                ? "Nenhuma descrição informada."
                                : selectedActivity.Description)

                        </div>

                    </div>


                    <!-- PERÍODO -->

                    <div class="detail-section">

                        <div class="detail-label">

                            <i class="bi bi-clock"></i>

                            <span>
                                Período
                            </span>

                        </div>

                        <div class="detail-period">

                            <div>

                                <span>
                                    Início
                                </span>

                                <strong>
                                    @selectedActivity.StartDate.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </strong>

                            </div>

                            <div class="period-arrow">

                                <i class="bi bi-arrow-right"></i>

                            </div>

                            <div>

                                <span>
                                    Fim
                                </span>

                                <strong>
                                    @selectedActivity.EndDate.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- RESPONSÁVEIS -->

                    <div class="detail-section">

                        <div class="detail-label">

                            <i class="bi bi-people"></i>

                            <span>
                                Responsáveis
                            </span>

                        </div>

                        @if (selectedActivity.Members is null ||
                             !selectedActivity.Members.Any())
                        {
                            <div class="detail-empty">

                                Nenhum responsável definido.

                            </div>
                        }
                        else
                        {
                            <div class="activity-members">

                                @foreach (var member
                                    in selectedActivity.Members)
                                {
                                    <div class="activity-member">

                                        <div class="member-avatar">

                                            @GetInitials(
                                                member.MemberName)

                                        </div>

                                        <span>
                                            @member.MemberName
                                        </span>

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary modal-cancel-button"
                            @onclick="CloseDetailsModal"
                            disabled="@isDeleting">

                        Fechar

                    </button>

                    <button type="button"
                            class="btn btn-danger modal-delete-button"
                            @onclick="OpenDeleteModal"
                            disabled="@isDeleting">

                        <i class="bi bi-trash"></i>

                        <span>
                            Remover
                        </span>

                    </button>

                </div>

            </div>

        </div>

    </div>
}


<!-- =========================================================
     MODAL - CONFIRMAR EXCLUSÃO
     ========================================================= -->
@if (showDeleteModal && selectedActivity is not null)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block activity-modal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <div class="modal-heading">

                        <div class="modal-icon delete-icon">
                            <i class="bi bi-trash"></i>
                        </div>

                        <div>

                            <h5>
                                Confirmar exclusão
                            </h5>

                            <span>
                                Esta ação não poderá ser desfeita.
                            </span>

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDeleteModal"
                            disabled="@isDeleting">
                    </button>

                </div>


                <div class="modal-body">

                    @if (deleteError is not null)
                    {
                        <div class="form-error">

                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                @deleteError
                            </span>

                        </div>
                    }

                    <div class="delete-confirmation">

                        <div class="delete-warning-icon">

                            <i class="bi bi-exclamation-triangle"></i>

                        </div>

                        <p>

                            Tem certeza que deseja remover a atividade

                            <strong>
                                @selectedActivity.Title
                            </strong>?

                        </p>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary modal-cancel-button"
                            @onclick="CloseDeleteModal"
                            disabled="@isDeleting">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-danger modal-delete-button"
                            @onclick="ConfirmDeleteActivity"
                            disabled="@isDeleting">

                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>

                            <span>
                                Removendo...
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>

                            <span>
                                Sim, remover
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code
{
    private bool isLoading = true;

    private bool calendarInitialized;

    private bool showCreateModal;

    private bool showDetailsModal;

    private bool showDeleteModal;

    private bool isSaving;

    private bool isDeleting;

    private string? loadError;

    private string? createError;

    private string? deleteError;

    private IEnumerable<ActivityDto>? activities;

    private List<MemberDto>? members;

    private ActivityDto? selectedActivity;

    private DotNetObjectReference<ActivityList>? dotNetReference;

    private string activityTitle = string.Empty;

    private string activityDescription = string.Empty;

    private DateTime activityStart =
        DateTime.Now.Date.AddHours(8);

    private DateTime activityEnd =
        DateTime.Now.Date.AddHours(9);

    private HashSet<Guid> selectedMemberIds = [];


    protected override async Task OnInitializedAsync()
    {
        try
        {
            activities =
                await ActivityService.GetAllActivities();

            members =
                await MemberService.GetAllMembers();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (isLoading)
            return;

        if (loadError is not null)
            return;

        if (calendarInitialized)
            return;

        calendarInitialized = true;

        dotNetReference =
            DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "motoFlowCalendar.initialize",
            "activity-calendar",
            dotNetReference);

        await RefreshCalendar();
    }


    [JSInvokable]
    public async Task OnCalendarDateClicked(
        string date)
    {
        if (!DateTime.TryParse(
                date,
                out var selectedDate))
        {
            return;
        }

        OpenCreateModal(selectedDate);

        await InvokeAsync(
            StateHasChanged);
    }


    [JSInvokable]
    public async Task OnCalendarEventClicked(
        string activityId)
    {
        if (!Guid.TryParse(
                activityId,
                out var id))
        {
            return;
        }

        deleteError = null;

        selectedActivity =
            await ActivityService.GetActivityById(id);

        if (selectedActivity is null)
            return;

        showDetailsModal = true;

        await InvokeAsync(
            StateHasChanged);
    }


    private void OpenCreateModal()
    {
        OpenCreateModal(
            DateTime.Now.Date);
    }


    private void OpenCreateModal(
        DateTime date)
    {
        createError = null;

        activityTitle =
            string.Empty;

        activityDescription =
            string.Empty;

        activityStart =
            date.Date.AddHours(8);

        activityEnd =
            date.Date.AddHours(9);

        selectedMemberIds.Clear();

        showCreateModal = true;
    }


    private void CloseCreateModal()
    {
        if (isSaving)
            return;

        showCreateModal = false;

        createError = null;
    }


    private void ToggleMember(
        Guid memberId,
        ChangeEventArgs args)
    {
        if (args.Value is bool isChecked &&
            isChecked)
        {
            selectedMemberIds.Add(memberId);
        }
        else
        {
            selectedMemberIds.Remove(memberId);
        }
    }


    private async Task CreateActivity()
    {
        createError = null;

        if (string.IsNullOrWhiteSpace(
                activityTitle))
        {
            createError =
                "Informe o título da atividade.";

            return;
        }

        if (activityEnd <= activityStart)
        {
            createError =
                "A data final deve ser posterior à data inicial.";

            return;
        }

        if (!selectedMemberIds.Any())
        {
            createError =
                "Selecione pelo menos um responsável.";

            return;
        }

        isSaving = true;

        try
        {
            var request =
                new CreateActivityRequest(
                    activityTitle,
                    activityDescription,
                    activityStart,
                    activityEnd,
                    selectedMemberIds.ToList());

            var error =
                await ActivityService.CreateActivity(
                    request);

            if (error is not null)
            {
                createError = error;

                return;
            }

            activities =
                await ActivityService.GetAllActivities();

            showCreateModal = false;

            await RefreshCalendar();
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private void CloseDetailsModal()
    {
        if (isDeleting)
            return;

        showDetailsModal = false;

        selectedActivity = null;

        deleteError = null;
    }


    private void OpenDeleteModal()
    {
        deleteError = null;

        showDetailsModal = false;

        showDeleteModal = true;
    }


    private void CloseDeleteModal()
    {
        if (isDeleting)
            return;

        showDeleteModal = false;

        deleteError = null;
    }


    private async Task ConfirmDeleteActivity()
    {
        if (selectedActivity is null)
            return;

        deleteError = null;

        isDeleting = true;

        try
        {
            var error =
                await ActivityService.DeleteActivity(
                    selectedActivity.Id);

            if (error is not null)
            {
                deleteError = error;

                return;
            }

            activities =
                await ActivityService.GetAllActivities();

            showDeleteModal = false;

            selectedActivity = null;

            await RefreshCalendar();
        }
        catch (Exception ex)
        {
            deleteError = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }


    private async Task RefreshCalendar()
    {
        if (!calendarInitialized)
            return;

        await JS.InvokeVoidAsync(
            "motoFlowCalendar.setActivities",
            activities ?? []);
    }


    private static string GetInitials(
        string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return
            $"{parts[0][0]}{parts[^1][0]}"
                .ToUpper();
    }


    public void Dispose()
    {
        dotNetReference?.Dispose();
    }
}