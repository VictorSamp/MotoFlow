@page "/members/edit/{Id:guid}"

@using MotoFlow.Domain.Enums
@using MotoFlow.Web.Components.ViewModels.Members
@using MotoFlow.Application.Members.UpdateMember

@inject MemberApiService MemberService
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Editar Membro | MotoFlow</PageTitle>

<div class="edit-member-page">

    <!-- Cabeçalho -->

    <div class="edit-member-header">

        <div>

            <div class="breadcrumb-area">

                <span>
                    Membros
                </span>

                <i class="bi bi-chevron-right"></i>

                <span class="current">
                    Editar membro
                </span>

            </div>

            <h1>
                Editar membro
            </h1>

            <p>
                Atualize as informações cadastrais do integrante.
            </p>

        </div>

    </div>


    @if (model is null)
    {
        <!-- Loading -->

        <div class="edit-member-panel">

            <div class="loading-state">

                <div class="spinner-border text-success"
                     role="status">
                </div>

                <p>
                    Carregando informações do membro...
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Formulário -->

        <div class="edit-member-panel">

            <div class="panel-header">

                <div class="panel-title">

                    <div class="panel-icon">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div>

                        <h5>
                            Informações do membro
                        </h5>

                        <span>
                            Atualize os dados cadastrais abaixo.
                        </span>

                    </div>

                </div>

            </div>


            <div class="panel-body">

                <EditForm Model="model"
                          OnValidSubmit="Save"
                          FormName="update-member-form">

                    <DataAnnotationsValidator />

                    <ValidationSummary class="validation-summary" />


                    <!-- Nome -->

                    <div class="form-group">

                        <label class="form-label">
                            Nome completo
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person"></i>

                            <InputText class="form-control"
                                       @bind-Value="model.Name"
                                       placeholder="Digite o nome completo" />

                        </div>

                        <ValidationMessage For="@(() => model.Name)"
                                           class="validation-message" />

                    </div>


                    <!-- Telefone -->

                    <div class="form-group">

                        <label class="form-label">
                            Telefone
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-telephone"></i>

                            <InputText class="form-control"
                                       @bind-Value="model.PhoneNumber"
                                       placeholder="Digite o telefone" />

                        </div>

                        <ValidationMessage For="@(() => model.PhoneNumber)"
                                           class="validation-message" />

                    </div>


                    <!-- Ações -->

                    <div class="form-actions">

                        <button type="button"
                                class="btn btn-light cancel-button"
                                @onclick="Cancel">

                            <i class="bi bi-arrow-left"></i>

                            Cancelar

                        </button>

                        <button type="submit"
                                class="btn btn-success save-button">

                            <i class="bi bi-check-lg"></i>

                            Salvar alterações

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public Guid Id { get; set; }


    private UpdateMemberViewModel? model;


    protected override async Task OnInitializedAsync()
    {
        var member =
            await MemberService.GetMemberById(Id);

        if (member is not null)
        {
            model = new UpdateMemberViewModel
            {
                Id = member.Id,
                Name = member.Name,
                PhoneNumber = member.PhoneNumber
            };
        }
    }


    private async Task Save()
    {
        if (model is null)
            return;

        var request =
            new UpdateMemberRequest(
                model.Name,
                model.PhoneNumber);

        await MemberService.UpdateMember(
            Id,
            request);

        Nav.NavigateTo("/members");
    }


    private void Cancel()
    {
        Nav.NavigateTo("/members");
    }

}