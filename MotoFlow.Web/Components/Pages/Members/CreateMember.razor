@using MotoFlow.Application.Members.CreateMember
@using MotoFlow.Web.Components.ViewModels.Members

@page "/members/new"

@inject MemberApiService MemberService
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Adicionar Membro | MotoFlow</PageTitle>

<div class="create-member-page">

    <!-- Cabeçalho -->

    <div class="create-member-header">

        <div>

            <div class="breadcrumb-area">

                <span>
                    Membros
                </span>

                <i class="bi bi-chevron-right"></i>

                <span class="current">
                    Novo membro
                </span>

            </div>

            <h1>
                Adicionar novo membro
            </h1>

            <p>
                Cadastre um novo integrante no motoclube.
            </p>

        </div>

    </div>


    <!-- Formulário -->

    <div class="create-member-panel">

        <div class="panel-header">

            <div class="panel-title">

                <div class="panel-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>

                <div>

                    <h5>
                        Informações do membro
                    </h5>

                    <span>
                        Preencha os dados cadastrais abaixo.
                    </span>

                </div>

            </div>

        </div>


        <div class="panel-body">

            <EditForm Model="model"
                      OnValidSubmit="Save"
                      FormName="create-member-model">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <!-- Nome -->

                <div class="form-group">

                    <label class="form-label">
                        Nome completo
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-person"></i>

                        <InputText class="form-control"
                                   @bind-Value="model.Name"
                                   placeholder="Digite o nome completo" />

                    </div>

                    <ValidationMessage For="@(() => model.Name)"
                                       class="validation-message" />

                </div>


                <!-- Email -->

                <div class="form-group">

                    <label class="form-label">
                        Email
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <InputText class="form-control"
                                   @bind-Value="model.Email"
                                   placeholder="Digite o email" />

                    </div>

                    <ValidationMessage For="@(() => model.Email)"
                                       class="validation-message" />

                </div>


                <!-- Telefone -->

                <div class="form-group">

                    <label class="form-label">
                        Telefone
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-telephone"></i>

                        <InputText class="form-control"
                                   @bind-Value="model.PhoneNumber"
                                   placeholder="Digite o telefone" />

                    </div>

                    <ValidationMessage For="@(() => model.PhoneNumber)"
                                       class="validation-message" />

                </div>


                <!-- Ações -->

                <div class="form-actions">

                    <button type="button"
                            class="btn btn-light cancel-button"
                            @onclick="Cancel">

                        <i class="bi bi-arrow-left"></i>

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-success save-button">

                        <i class="bi bi-check-lg"></i>

                        Adicionar membro

                    </button>

                </div>

            </EditForm>

        </div>

    </div>

</div>


@code {

    private CreateMemberViewModel model = new();


    private async Task Save()
    {
        var request =
            new CreateMemberRequest(
                model.Name,
                model.Email,
                model.PhoneNumber);

        await MemberService.CreateMember(request);

        Nav.NavigateTo("/members");
    }


    private void Cancel()
    {
        Nav.NavigateTo("/members");
    }

}