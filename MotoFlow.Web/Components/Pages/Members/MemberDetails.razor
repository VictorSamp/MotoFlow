@page "/members/{Id:guid}"

@using MotoFlow.Application.Members.Dtos
@using MotoFlow.Application.MembershipFees.CreateMembershipFee
@using MotoFlow.Domain.Enums

@inject MemberApiService MemberService
@inject MembershipFeeApiService MembershipFeeService

@rendermode InteractiveServer

<h3>Informações do Membro</h3>

@if (member is null)
{
    <p>Carregando...</p>
}
else
{
    <div>
        <p><b>Nome:</b> @member.Name</p>
        <p><b>Email:</b> @member.Email</p>
        <p><b>Telefone:</b> @member.PhoneNumber</p>
        <p><b>Nível da Insígnia:</b> @member.CurrentPatchLevel</p>
        <p><b>Data de Ingresso:</b> @member.JoinDate</p>

        @if (progressionError is not null)
        {
            <div class="alert alert-danger">
                @progressionError
            </div>
        }

        @if (member.Status == MemberStatus.Active && AvailablePatchLevels.Any())
        {
            <div class="mb-4">
                <label class="form-label">
                    Progredir nível da insígnia
                </label>

                <div class="d-flex gap-2">
                    <InputSelect class="form-select"
                                 @bind-Value="selectedPatchLevel">

                        @foreach (var level in AvailablePatchLevels)
                        {
                            <option value="@level">
                                @level
                            </option>
                        }

                    </InputSelect>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="ProgressMember">
                        Progredir
                    </button>
                </div>
            </div>
        }
        else if (member.Status == MemberStatus.Active)
        {
            <p class="text-muted">
                O membro já possui a insígnia completa.
            </p>
        }

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Mensalidades</h4>

            <button type="button"
                    class="btn btn-success"
                    @onclick="OpenCreateFeeModal">
                + Adicionar mensalidade
            </button>
        </div>

        @if (member.MembershipFees is null || !member.MembershipFees.Any())
        {
            <p>Nenhuma mensalidade encontrada.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Competência</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th>Data de Pagamento</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var fee in member.MembershipFees)
                    {
                        <tr>
                            <td>
                                @fee.ReferencePeriod.ToString("MM/yyyy")
                            </td>

                            <td>
                                @fee.Amount.ToString("C")
                            </td>

                            <td>
                                @fee.Status
                            </td>

                            <td>
                                @(fee.PaymentDate.HasValue
                                    ? fee.PaymentDate.Value.ToString("dd/MM/yyyy")
                                    : "-")
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        @onclick="() => OpenDeleteFeeModal(fee.Id)">
                                    Remover
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (showCreateFeeModal)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Nova mensalidade
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseCreateFeeModal">
                    </button>
                </div>

                <div class="modal-body">

                    @if (createFeeError is not null)
                    {
                        <div class="alert alert-danger">
                            @createFeeError
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">
                            Membro
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@member?.Name"
                               disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Competência
                        </label>

                        <input type="month"
                               class="form-control"
                               @bind="feeReferencePeriod" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Valor
                        </label>

                        <input type="number"
                               class="form-control"
                               step="0.01"
                               min="0"
                               @bind="feeAmount" />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseCreateFeeModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="CreateFee"
                            disabled="@isCreatingFee">

                        @if (isCreatingFee)
                        {
                            <span>Criando...</span>
                        }
                        else
                        {
                            <span>Criar</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@if (showDeleteFeeModal)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Confirmar exclusão
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDeleteFeeModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        Tem certeza que deseja remover esta mensalidade?
                    </p>
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDeleteFeeModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmDeleteFee">
                        Sim, remover
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code
{
    [Parameter]
    public Guid Id { get; set; }

    private MemberDetailsDto? member;

    private PatchLevel selectedPatchLevel;

    private string? progressionError;

    private bool showCreateFeeModal;

    private string? createFeeError;

    private bool isCreatingFee;

    private bool showDeleteFeeModal;

    private Guid selectedFeeId;

    private DateTime feeReferencePeriod =
        new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);

    private decimal feeAmount = 30.00m;

    private IEnumerable<PatchLevel> AvailablePatchLevels =>
        Enum.GetValues<PatchLevel>()
            .Where(level =>
                member is not null &&
                level > member.CurrentPatchLevel);

    protected override async Task OnInitializedAsync()
    {
        await LoadMember();

        selectedPatchLevel =
            AvailablePatchLevels.FirstOrDefault();
    }

    private async Task LoadMember()
    {
        member = await MemberService.GetMemberById(Id);
    }

    private void OpenCreateFeeModal()
    {
        createFeeError = null;

        feeReferencePeriod =
            new DateTime(
                DateTime.UtcNow.Year,
                DateTime.UtcNow.Month,
                1);

        feeAmount = 30.00m;

        showCreateFeeModal = true;
    }

    private void CloseCreateFeeModal()
    {
        if (isCreatingFee)
            return;

        showCreateFeeModal = false;
        createFeeError = null;
    }

    private async Task CreateFee()
    {
        createFeeError = null;
        isCreatingFee = true;

        try
        {
            var request = new CreateMembershipFeeRequest(
                feeReferencePeriod,
                feeAmount);

            var error = await MembershipFeeService.CreateMembershipFee(
                Id,
                request);

            if (error is not null)
            {
                createFeeError = error;
                return;
            }

            await LoadMember();

            showCreateFeeModal = false;
        }
        finally
        {
            isCreatingFee = false;
        }
    }

    private void OpenDeleteFeeModal(Guid feeId)
    {
        selectedFeeId = feeId;
        showDeleteFeeModal = true;
    }

    private void CloseDeleteFeeModal()
    {
        showDeleteFeeModal = false;
        selectedFeeId = Guid.Empty;
    }

    private async Task ConfirmDeleteFee()
    {
        await MembershipFeeService.DeleteMembershipFee(
            Id,
            selectedFeeId);

        await LoadMember();

        CloseDeleteFeeModal();
    }

    private async Task ProgressMember()
    {
        if (member is null)
            return;

        progressionError =
            await MemberService.UpdateMemberPatchLevel(
                member.Id,
                selectedPatchLevel);

        if (progressionError is not null)
            return;

        await LoadMember();

        selectedPatchLevel =
            AvailablePatchLevels.FirstOrDefault();
    }
}