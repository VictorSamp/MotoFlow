@page "/dashboard"

@using MotoFlow.Web.Components.ViewModels.Dashboard
@using MotoFlow.Web.Services
@inject DashboardApiService DashboardService

<PageTitle>Dashboard | MotoFlow</PageTitle>

<div class="dashboard">

    <!-- Cabeçalho -->
    <div class="dashboard-header">

        <div>
            <h1>Dashboard</h1>

            <p>
                Visão geral do seu motoclube.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd/MM/yyyy")
        </div>

    </div>


    @if (dashboard is null)
    {
        <div class="dashboard-loading">

            <div class="spinner-border text-success"
                 role="status">
            </div>

            <p>
                Carregando informações...
            </p>

        </div>
    }
    else
    {
        <!-- Indicadores -->
        <div class="row g-4 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="card-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="card-content">

                        <span class="card-label">
                            Total de Membros
                        </span>

                        <strong class="card-value">
                            @dashboard.TotalMembers
                        </strong>

                        <span class="card-description">
                            Membros cadastrados
                        </span>

                    </div>

                </div>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="card-icon success">
                        <i class="bi bi-person-check-fill"></i>
                    </div>

                    <div class="card-content">

                        <span class="card-label">
                            Membros Ativos
                        </span>

                        <strong class="card-value">
                            @dashboard.ActiveMembers
                        </strong>

                        <span class="card-description">
                            Atualmente ativos
                        </span>

                    </div>

                </div>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="card-icon danger">
                        <i class="bi bi-person-x-fill"></i>
                    </div>

                    <div class="card-content">

                        <span class="card-label">
                            Membros Inativos
                        </span>

                        <strong class="card-value">
                            @dashboard.InactiveMembers
                        </strong>

                        <span class="card-description">
                            Atualmente inativos
                        </span>

                    </div>

                </div>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="card-icon warning">
                        <i class="bi bi-award-fill"></i>
                    </div>

                    <div class="card-content">

                        <span class="card-label">
                            Níveis de Insígnia
                        </span>

                        <strong class="card-value">
                            @dashboard.PatchLevelsUsed
                        </strong>

                        <span class="card-description">
                            Níveis utilizados
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Conteúdo -->
        <div class="row g-4">

            <!-- Distribuição -->
            <div class="col-lg-6">

                <div class="dashboard-panel">

                    <div class="panel-header">

                        <div>

                            <h5>
                                Distribuição por Insígnia
                            </h5>

                            <span>
                                Membros por nível atual
                            </span>

                        </div>

                        <div class="panel-header-icon">
                            <i class="bi bi-bar-chart-fill"></i>
                        </div>

                    </div>


                    @if (dashboard.PatchDistribution.Count == 0)
                    {
                        <div class="empty-state">

                            <i class="bi bi-inbox"></i>

                            <span>
                                Nenhuma informação disponível.
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table dashboard-table">

                                <thead>

                                    <tr>
                                        <th>Insígnia</th>
                                        <th class="text-end">
                                            Quantidade
                                        </th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in dashboard.PatchDistribution)
                                    {
                                        <tr>

                                            <td>
                                                <div class="patch-name">

                                                    <span class="patch-dot"></span>

                                                    @TranslatePatch(item.Key)

                                                </div>
                                            </td>

                                            <td class="text-end">

                                                <span class="quantity-badge">
                                                    @item.Value
                                                </span>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>


            <!-- Membros -->
            <div class="col-lg-6">

                <div class="dashboard-panel">

                    <div class="panel-header">

                        <div>

                            <h5>
                                Membros Cadastrados
                            </h5>

                            <span>
                                Visão dos membros recentes
                            </span>

                        </div>

                        <div class="panel-header-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                    </div>


                    @if (dashboard.RecentMembers.Count == 0)
                    {
                        <div class="empty-state">

                            <i class="bi bi-person-plus"></i>

                            <span>
                                Nenhum membro cadastrado.
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table dashboard-table">

                                <thead>

                                    <tr>
                                        <th>Nome</th>
                                        <th>Insígnia</th>
                                        <th class="text-end">
                                            Status
                                        </th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var member in dashboard.RecentMembers)
                                    {
                                        <tr>

                                            <td>

                                                <div class="member-name">

                                                    <div class="member-avatar">
                                                        @GetInitials(member.Name)
                                                    </div>

                                                    <span>
                                                        @member.Name
                                                    </span>

                                                </div>

                                            </td>

                                            <td>
                                                @TranslatePatch(
                                                    member.CurrentPatchLevel)
                                            </td>

                                            <td class="text-end">

                                                @if (member.Status == "Active")
                                                {
                                                    <span class="status-badge active">
                                                        <span></span>
                                                        Ativo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive">
                                                        <span></span>
                                                        Inativo
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

</div>


@code {

    private DashboardDto? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard =
            await DashboardService.GetDashboard();
    }

    private static string TranslatePatch(string level)
    {
        return level switch
        {
            "None" => "Nenhuma Parte",
            "FirstPatch" => "Primeira Etapa",
            "SecondPatch" => "Segunda Etapa",
            "FullPatch" => "Insígnia Completa",
            _ => level
        };
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

}